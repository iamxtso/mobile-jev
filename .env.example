# ADB device serial. Must name one already-connected device; the adapter never selects a device.
ADB_SERIAL=

# Create a TypeSafe key at https://console.typesafe.ai
TYPESAFE_API_KEY=
# Model name (required).
TYPESAFE_MODEL=jev-latest

# Optional: another System One endpoint, e.g. a self-hosted vLLM Semantic Router.
# A base URL; /systemone is appended. Defaults to https://api.typesafe.ai/v1
TYPESAFE_BASE_URL=

# Studio port (required). Binds to localhost only; change this if the port is already in use.
STUDIO_PORT=3040
